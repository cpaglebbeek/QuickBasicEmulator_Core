{
  "dialect": "gwbasic",
  "description": "GW-BASIC (1983-1988) — Microsoft BASIC interpreter for IBM PC, line-number based, no SUB/FUNCTION",
  "source_reference": "https://github.com/microsoft/GW-BASIC (MIT, spec-referentie only, geen verbatim port)",
  "spec_version": "0.0.2-Allen",
  "features": {
    "line_numbers": "required",
    "tokenized_format": "supported",
    "labels": "not_supported",
    "sub_function_procedures": "not_supported",
    "multi_line_if": "not_supported",
    "select_case": "not_supported",
    "do_loop": "not_supported",
    "type_suffixes": "supported",
    "user_defined_types": "not_supported",
    "shared_keyword": "not_supported",
    "compile_to_exe": "not_supported"
  },
  "statements": {
    "PRINT":      { "args": "expr-list", "trailing": ["NL", ";", ","] },
    "INPUT":      { "args": "[prompt-str ;|,] var-list" },
    "LET":        { "args": "var = expr", "optional": true },
    "IF":         { "args": "expr THEN stmt|line-no [ELSE stmt|line-no]", "form": "single-line-only" },
    "FOR":        { "args": "var = expr TO expr [STEP expr]" },
    "NEXT":       { "args": "[var]" },
    "GOTO":       { "args": "line-no" },
    "GOSUB":      { "args": "line-no" },
    "RETURN":     { "args": "[line-no]" },
    "DIM":        { "args": "var(dims) [, ...]" },
    "DATA":       { "args": "literal-list" },
    "READ":       { "args": "var-list" },
    "RESTORE":    { "args": "[line-no]" },
    "OPEN":       { "args": "filespec FOR mode AS #file-no [LEN=n]" },
    "CLOSE":      { "args": "[#file-no [, ...]]" },
    "PRINT#":     { "args": "#file-no , expr-list" },
    "INPUT#":     { "args": "#file-no , var-list" },
    "LINE INPUT": { "args": "[#file-no ,] [prompt-str ;] var$" },
    "WHILE":      { "args": "expr" },
    "WEND":       { "args": "" },
    "REM":        { "args": "comment", "delim_also": "'" },
    "CLS":        { "args": "" },
    "COLOR":      { "args": "[fg [, bg [, border]]]" },
    "LOCATE":     { "args": "[row [, col [, cursor]]]" },
    "SCREEN":     { "args": "mode [, color-switch [, apage [, vpage]]]" },
    "RANDOMIZE":  { "args": "[seed]" },
    "DEF FN":     { "args": "name(params) = expr", "notes": "GW-BASIC inline-function-def" },
    "ON":         { "args": "expr GOTO|GOSUB line-list" },
    "STOP":       { "args": "" },
    "END":        { "args": "" },
    "CONT":       { "args": "" },
    "NEW":        { "args": "" },
    "RUN":        { "args": "[line-no|filespec]" },
    "LIST":       { "args": "[range]" },
    "DELETE":     { "args": "range" },
    "AUTO":       { "args": "[start [, inc]]" },
    "RENUM":      { "args": "[newstart [, oldstart [, inc]]]" },
    "MERGE":      { "args": "filespec" },
    "SAVE":       { "args": "filespec [, A|P]" },
    "LOAD":       { "args": "filespec [, R]" },
    "KILL":       { "args": "filespec" },
    "NAME":       { "args": "oldspec AS newspec" },
    "FILES":      { "args": "[filespec]" },
    "CHAIN":      { "args": "filespec [, line-no [, ALL]]" },
    "COMMON":     { "args": "var-list" },
    "POKE":       { "args": "address , value" },
    "OUT":        { "args": "port , value" },
    "DEF SEG":    { "args": "[= expr]" },
    "DEFINT":     { "args": "letter-range" },
    "DEFSTR":     { "args": "letter-range" },
    "DEFSNG":     { "args": "letter-range" },
    "DEFDBL":     { "args": "letter-range" },
    "DEFLNG":     { "args": "letter-range" }
  },
  "builtin_functions": {
    "ABS": { "args": "(n)" }, "ASC": { "args": "(s$)" }, "ATN": { "args": "(n)" },
    "CHR$": { "args": "(n)" }, "COS": { "args": "(n)" }, "EXP": { "args": "(n)" },
    "INKEY$": { "args": "" }, "INPUT$": { "args": "(n [, #file-no])" },
    "INSTR": { "args": "([start,] s1$, s2$)" }, "INT": { "args": "(n)" },
    "LEFT$": { "args": "(s$, n)" }, "LEN": { "args": "(s$)" }, "LOG": { "args": "(n)" },
    "MID$": { "args": "(s$, start [, n])" }, "RIGHT$": { "args": "(s$, n)" },
    "RND": { "args": "[(n)]" }, "SGN": { "args": "(n)" }, "SIN": { "args": "(n)" },
    "SPACE$": { "args": "(n)" }, "SQR": { "args": "(n)" }, "STR$": { "args": "(n)" },
    "STRING$": { "args": "(n, char)" }, "TAB": { "args": "(n)" }, "TAN": { "args": "(n)" },
    "TIMER": { "args": "" }, "TIME$": { "args": "" }, "DATE$": { "args": "" },
    "VAL": { "args": "(s$)" }, "PEEK": { "args": "(addr)" }, "POS": { "args": "(0)" },
    "CSRLIN": { "args": "" }, "EOF": { "args": "(file-no)" }, "FRE": { "args": "(arg)" }
  },
  "operators": {
    "arithmetic": ["+", "-", "*", "/", "\\", "^", "MOD"],
    "comparison": ["=", "<>", "<", ">", "<=", ">="],
    "logical": ["NOT", "AND", "OR", "XOR", "EQV", "IMP"]
  },
  "type_suffixes": { "$": "STRING", "%": "INTEGER", "!": "SINGLE", "#": "DOUBLE" }
}
