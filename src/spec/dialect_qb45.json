{
  "dialect": "qb45",
  "description": "QuickBASIC 4.5 (1988-1990) — compiles to .exe (BRUN or Stand-alone), superset of QBasic",
  "spec_version": "0.0.2-Allen",
  "compile_modes": {
    "BRUN": "Dynamic link to BRUN45.EXE runtime — small .exe with p-code",
    "Stand-alone": "Statically linked BCOM45.LIB — larger .exe with native x86 + linked runtime stubs"
  },
  "features": {
    "line_numbers": "optional",
    "tokenized_format": "not_applicable",
    "labels": "supported",
    "sub_function_procedures": "supported",
    "multi_line_if": "supported",
    "select_case": "supported",
    "do_loop": "supported",
    "type_suffixes": "supported",
    "user_defined_types": "supported",
    "shared_keyword": "supported_in_sub_function_only",
    "compile_to_exe": "supported",
    "metacommands": "supported",
    "include_metacommand": "supported",
    "static_arrays": "supported",
    "common_shared": "supported"
  },
  "statements": {
    "PRINT":        { "args": "expr-list", "trailing": ["NL", ";", ","] },
    "INPUT":        { "args": "[prompt-str ;|,] var-list" },
    "LET":          { "args": "var = expr", "optional": true },
    "IF":           { "args": "expr THEN stmt | block", "form": "single-line-or-block" },
    "THEN":         { "args": "stmt | newline" },
    "ELSEIF":       { "args": "expr THEN" },
    "ELSE":         { "args": "" },
    "END IF":       { "args": "" },
    "FOR":          { "args": "var = expr TO expr [STEP expr]" },
    "NEXT":         { "args": "[var [, ...]]" },
    "GOTO":         { "args": "label | line-no" },
    "GOSUB":        { "args": "label | line-no" },
    "RETURN":       { "args": "[label | line-no]" },
    "SUB":          { "args": "name [(params)] [STATIC]" },
    "END SUB":      { "args": "" },
    "FUNCTION":     { "args": "name [(params)] [STATIC]" },
    "END FUNCTION": { "args": "" },
    "DIM":          { "args": "[SHARED] var(dims) [AS type] [, ...]" },
    "REDIM":        { "args": "[SHARED] [PRESERVE] var(dims) [AS type]" },
    "DATA":         { "args": "literal-list" },
    "READ":         { "args": "var-list" },
    "RESTORE":      { "args": "[label | line-no]" },
    "OPEN":         { "args": "filespec FOR mode [ACCESS access] [LOCK lock] AS #file-no [LEN=n]" },
    "CLOSE":        { "args": "[#file-no [, ...]]" },
    "PRINT#":       { "args": "#file-no , expr-list" },
    "INPUT#":       { "args": "#file-no , var-list" },
    "LINE INPUT":   { "args": "[#file-no ,] [prompt-str ;] var$" },
    "SELECT CASE":  { "args": "expr" },
    "CASE":         { "args": "value | range | IS op value | ELSE" },
    "END SELECT":   { "args": "" },
    "DO":           { "args": "[WHILE|UNTIL expr]" },
    "LOOP":         { "args": "[WHILE|UNTIL expr]" },
    "WHILE":        { "args": "expr" },
    "WEND":         { "args": "" },
    "EXIT":         { "args": "FOR | DO | SUB | FUNCTION" },
    "CALL":         { "args": "name [(args)]", "optional": true },
    "REM":          { "args": "comment", "delim_also": "'" },
    "CLS":          { "args": "[mode]" },
    "COLOR":        { "args": "[fg [, bg [, border]]]" },
    "LOCATE":       { "args": "[row [, col [, cursor [, start [, stop]]]]]" },
    "SCREEN":       { "args": "mode [, color-switch [, apage [, vpage]]]" },
    "SLEEP":        { "args": "[seconds]" },
    "RANDOMIZE":    { "args": "[seed | TIMER]" },
    "SHARED":       { "args": "var-list [AS type]", "context": "inside SUB/FUNCTION only" },
    "DECLARE":      { "args": "SUB|FUNCTION name [(params)]" },
    "TYPE":         { "args": "name", "block_end": "END TYPE" },
    "END TYPE":     { "args": "" },
    "COMMON":       { "args": "[SHARED] var-list" },
    "CONST":        { "args": "[SHARED] name = expr [, ...]" },
    "STATIC":       { "args": "var-list [AS type]", "context": "inside SUB/FUNCTION" },
    "ON ERROR":     { "args": "GOTO label | line-no" },
    "ON KEY":       { "args": "(n) GOSUB label | line-no" },
    "ON TIMER":     { "args": "(n) GOSUB label | line-no" },
    "STOP":         { "args": "" },
    "END":          { "args": "" }
  },
  "builtin_functions": {
    "ABS": { "args": "(n)" }, "ASC": { "args": "(s$)" }, "ATN": { "args": "(n)" },
    "CDBL": { "args": "(n)" }, "CHR$": { "args": "(n)" }, "CINT": { "args": "(n)" },
    "CLNG": { "args": "(n)" }, "COS": { "args": "(n)" }, "CSNG": { "args": "(n)" },
    "CVD": { "args": "(s$)" }, "CVI": { "args": "(s$)" }, "CVL": { "args": "(s$)" },
    "CVS": { "args": "(s$)" }, "EXP": { "args": "(n)" }, "FIX": { "args": "(n)" },
    "HEX$": { "args": "(n)" }, "INKEY$": { "args": "" },
    "INPUT$": { "args": "(n [, #file-no])" }, "INSTR": { "args": "([start,] s1$, s2$)" },
    "INT": { "args": "(n)" }, "LBOUND": { "args": "(array [, dim])" },
    "LCASE$": { "args": "(s$)" }, "LEFT$": { "args": "(s$, n)" }, "LEN": { "args": "(s$|var)" },
    "LOG": { "args": "(n)" }, "LTRIM$": { "args": "(s$)" }, "MID$": { "args": "(s$, start [, n])" },
    "MKD$": { "args": "(n)" }, "MKI$": { "args": "(n)" }, "MKL$": { "args": "(n)" },
    "MKS$": { "args": "(n)" }, "OCT$": { "args": "(n)" }, "RIGHT$": { "args": "(s$, n)" },
    "RND": { "args": "[(n)]" }, "RTRIM$": { "args": "(s$)" }, "SGN": { "args": "(n)" },
    "SIN": { "args": "(n)" }, "SPACE$": { "args": "(n)" }, "SQR": { "args": "(n)" },
    "STR$": { "args": "(n)" }, "STRING$": { "args": "(n, char)" }, "TAN": { "args": "(n)" },
    "TIMER": { "args": "" }, "TIME$": { "args": "" }, "DATE$": { "args": "" },
    "UBOUND": { "args": "(array [, dim])" }, "UCASE$": { "args": "(s$)" },
    "VAL": { "args": "(s$)" }, "VARPTR": { "args": "(var)" }, "VARSEG": { "args": "(var)" },
    "EOF": { "args": "(file-no)" }, "ERR": { "args": "" }, "ERL": { "args": "" }
  },
  "operators": {
    "arithmetic": ["+", "-", "*", "/", "\\", "^", "MOD"],
    "comparison": ["=", "<>", "<", ">", "<=", ">="],
    "logical": ["NOT", "AND", "OR", "XOR", "EQV", "IMP"]
  },
  "type_suffixes": { "$": "STRING", "%": "INTEGER", "&": "LONG", "!": "SINGLE", "#": "DOUBLE" },
  "metacommands": ["$STATIC", "$DYNAMIC", "$INCLUDE"]
}
